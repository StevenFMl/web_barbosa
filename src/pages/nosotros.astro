---
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import NosotrosSection from '../components/NosotrosSection.jsx';
import FooterUbicacion from '../components/FooterUbicacion.jsx';
import WhatsAppButton from '../components/WhatsAppButton.jsx';
---

<html lang="es" class="scroll-smooth bg-[#040504]">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Nosotros | Casa Barbosa</title>
		<meta name="description" content="Conoce la historia de Casa Barbosa. Cuatro años cocinando chancho a la Barbosa al carbón y leña en Ibarra, Ecuador." />

		<link rel="canonical" href="https://casabarbosa.ec/nosotros" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#040504" />

		<meta property="og:type"        content="website" />
		<meta property="og:site_name"   content="Casa Barbosa" />
		<meta property="og:title"       content="Nuestra Historia | Casa Barbosa" />
		<meta property="og:description" content="Cuatro años cocinando chancho a la Barbosa al carbón y leña. Wilson Andrés Cárdenas y su sazón propia en El Olivo, Ibarra." />
		<meta property="og:url"         content="https://casabarbosa.ec/nosotros" />
		<meta property="og:image"       content="https://casabarbosa.ec/logo-barbosa.png" />
		<meta property="og:image:width"  content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale"      content="es_EC" />

		<meta name="twitter:card"        content="summary_large_image" />
		<meta name="twitter:title"       content="Nuestra Historia | Casa Barbosa" />
		<meta name="twitter:description" content="Cuatro años cocinando chancho a la Barbosa al carbón y leña en Ibarra, Ecuador." />
		<meta name="twitter:image"       content="https://casabarbosa.ec/logo-barbosa.png" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#040504] text-stone-100 font-sans antialiased overflow-x-hidden selection:bg-amber-500/40 selection:text-white">
		<Navbar client:load />
		<main>
			<NosotrosSection client:load />
		</main>
		<FooterUbicacion client:visible />
		<WhatsAppButton client:idle />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		scroll-behavior: smooth;
	}

	section[id] {
		scroll-margin-top: 5rem;
	}

	.font-display {
		font-family: 'Cinzel', serif;
	}
	.font-serif {
		font-family: 'Crimson Text', serif;
	}
</style>
