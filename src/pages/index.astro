---
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import HeroElegante from '../components/HeroElegante.jsx';
import ScarcityOffer from '../components/ScarcityOffer.jsx';
import MenuPremium from '../components/MenuPremium.jsx';
import FooterUbicacion from '../components/FooterUbicacion.jsx';
import WhatsAppButton from '../components/WhatsAppButton.jsx';
import ResenasPremium from '../components/ResenasPremium.jsx';
import HistoriaTeaser from '../components/HistoriaTeaser.jsx';
---

<html lang="es" class="scroll-smooth bg-[#040504]">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Casa Barbosa | Steakhouse Premium en Ibarra</title>
		<meta name="description" content="Chancho a la Barbosa al carbón y leña. Todos los días, 11:00–23:00. Panamericana Norte, El Olivo, Ibarra, Ecuador." />

		<link rel="canonical" href="https://casalabarbosa.com/" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#040504" />

		<meta property="og:type"        content="restaurant" />
		<meta property="og:site_name"   content="Casa Barbosa" />
		<meta property="og:title"       content="Casa Barbosa | Steakhouse Premium en Ibarra" />
		<meta property="og:description" content="Chancho a la Barbosa al carbón y leña. Todos los días, 11:00–23:00. Panamericana Norte, El Olivo, Ibarra, Ecuador." />
		<meta property="og:url"         content="https://casalabarbosa.com/" />
		<meta property="og:image"       content="https://casalabarbosa.com/logo-barbosa.png" />
		<meta property="og:image:width"  content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale"      content="es_EC" />

		<meta name="twitter:card"        content="summary_large_image" />
		<meta name="twitter:title"       content="Casa Barbosa | Steakhouse Premium en Ibarra" />
		<meta name="twitter:description" content="Chancho a la Barbosa al carbón y leña. Todos los días, 11:00–23:00. El Olivo, Ibarra." />
		<meta name="twitter:image"       content="https://casalabarbosa.com/logo-barbosa.png" />

		<!-- Schema.org JSON-LD para Google Search & Maps -->
		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": "Restaurant",
			"name": "Casa Barbosa",
			"alternateName": "Casa Barbosa Steakhouse Ibarra",
			"image": "https://casalabarbosa.com/logo-barbosa.png",
			"url": "https://casalabarbosa.com/",
			"telephone": "+593984085851",
			"priceRange": "$$",
			"servesCuisine": ["Ecuadorian", "Steakhouse", "Barbecue", "Chancho a la Barbosa"],
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "Panamericana Norte E35 1 C3 y Luis Fernando Madera, sector El Olivo",
				"addressLocality": "Ibarra",
				"addressRegion": "Imbabura",
				"postalCode": "100105",
				"addressCountry": "EC"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": 0.3661,
				"longitude": -78.1121
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
					"opens": "11:00",
					"closes": "23:00"
				}
			],
			"menu": "https://casalabarbosa.com/#menu",
			"acceptsReservations": "True",
			"sameAs": [
				"https://www.instagram.com/casalabarbosa/",
				"https://www.facebook.com/chanchobarbosaibarra",
				"https://www.tiktok.com/@casaalabarbosa"
			]
		}
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#040504] text-stone-100 font-sans antialiased overflow-x-hidden selection:bg-amber-500/40 selection:text-white">
		<Navbar client:load />
		<main class="relative">
			<HeroElegante client:load />
			<ScarcityOffer client:visible />
			<MenuPremium client:visible />
			<HistoriaTeaser client:visible />
			<ResenasPremium client:visible />
		</main>
		<FooterUbicacion client:visible />
		<WhatsAppButton client:idle />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		scroll-behavior: smooth;
	}

	section[id] {
		scroll-margin-top: 5rem;
	}

	.font-display {
		font-family: 'Cinzel', serif;
	}
	.font-serif {
		font-family: 'Crimson Text', serif;
	}
</style>
